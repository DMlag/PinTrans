<Window x:Class="AiPhoto.App.LongCapture.LongCaptureFrame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinTrans 长截图区域"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" ShowActivated="False"
        WindowStartupLocation="Manual" IsHitTestVisible="False">
    <!-- The frame sits just outside the capture region; the window is click-through and excluded from capture. -->
    <Rectangle x:Name="FrameRect" Stroke="#FFE53935" StrokeThickness="2" StrokeDashArray="4 3" />
</Window>
