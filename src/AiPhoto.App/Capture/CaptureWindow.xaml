<Window x:Class="AiPhoto.App.Capture.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ann="clr-namespace:AiPhoto.App.Annotations"
        xmlns:sel="clr-namespace:AiPhoto.App.Capture.Selection"
        Title="AiPhoto 截图"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="Black"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}"
        InputMethod.IsInputMethodEnabled="False"
        KeyboardNavigation.TabNavigation="None"
        Cursor="Cross">

    <!-- IME is disabled for the window so single-letter tool shortcuts (R, E, A...) arrive as normal keys instead
         of Key.ImeProcessed / opening a composition window when a Chinese IME is active; TextEditor re-enables it. -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Pixel space: 1 unit = 1 captured pixel. The ScaleTransform cancels WPF's DPI scaling.
             The pixel canvas is hosted in a plain Canvas on purpose: a Canvas measures its children with
             infinite space, so the (DPI-times larger than the window) pixel canvas does not get a layout clip.
             Directly inside the Grid it would be clipped to the window size in its *local* (pre-scale)
             coordinates, i.e. only 1/scale of the screenshot would be visible at >100% DPI. -->
        <Canvas>
        <Canvas x:Name="PixelCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas.RenderTransform>
                <ScaleTransform x:Name="PixelScale" ScaleX="1" ScaleY="1" />
            </Canvas.RenderTransform>
            <Image x:Name="Backdrop" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            <sel:SelectionAdorner x:Name="Adorner" />
            <ann:AnnotationLayer x:Name="Layer" />
        </Canvas>
        </Canvas>

        <!-- UI space (DIPs): toolbars, magnifier, text editor. -->
        <Canvas x:Name="UiCanvas">
            <Border x:Name="SizeLabel" Background="#CC000000" CornerRadius="3" Padding="6,2" Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
            </Border>

            <Border x:Name="Magnifier" Background="#E6202124" CornerRadius="4" Padding="4" Visibility="Collapsed"
                    IsHitTestVisible="False" BorderBrush="#55FFFFFF" BorderThickness="1">
                <StackPanel>
                    <Grid Width="120" Height="120" ClipToBounds="True">
                        <Image x:Name="MagnifierImage" Width="120" Height="120" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Rectangle Width="120" Height="8" Fill="#552F7CF6" VerticalAlignment="Center" />
                        <Rectangle Width="8" Height="120" Fill="#552F7CF6" HorizontalAlignment="Center" />
                        <Rectangle Width="8" Height="8" Stroke="White" StrokeThickness="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="MagnifierPos" Foreground="White" FontSize="11" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Border x:Name="MagnifierSwatch" Width="12" Height="12" BorderBrush="White" BorderThickness="1" Margin="0,0,4,0" />
                        <TextBlock x:Name="MagnifierColor" Foreground="White" FontSize="11" />
                    </StackPanel>
                    <TextBlock x:Name="MagnifierHint" Text="C 复制颜色 · 滚轮/Tab 切换层级" Foreground="#99FFFFFF" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="ToolbarHost" Visibility="Collapsed" Cursor="Arrow">
                <!-- Auto-detected QR code / barcode quick action banner -->
                <Border x:Name="QrBanner" Style="{StaticResource ToolbarBorder}" Margin="0,0,0,6" Padding="8,4"
                        HorizontalAlignment="Right" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#3310B981" BorderBrush="#AA10B981" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="QrBannerBadge" Text="二维码" Foreground="#FF5FD38D" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock x:Name="QrBannerText" Foreground="White" FontSize="12" MaxWidth="280" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ToolButton}" Width="46" Height="24" Click="OnCopyQrBanner" ToolTip="复制二维码内容并完成">
                            <TextBlock Text="复制" FontFamily="{StaticResource UiFont}" FontSize="11.5" />
                        </Button>
                        <Button x:Name="QrBannerOpenButton" Style="{StaticResource ToolButton}" Width="64" Height="24" Margin="4,0,0,0"
                                Click="OnOpenQrBannerUrl" Visibility="Collapsed" ToolTip="在浏览器中打开链接">
                            <TextBlock Text="打开链接" FontFamily="{StaticResource UiFont}" FontSize="11.5" Foreground="#FF5FD38D" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ToolbarBorder}">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ToolRectangle" Tag="Rectangle" Style="{StaticResource ToolButton}" Click="OnToolClick" ToolTip="矩形 (R)">
                            <Rectangle Width="15" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" StrokeThickness="1.6" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolEllipse" Tag="Ellipse" Style="{StaticResource ToolButton}" Click="OnToolClick" ToolTip="椭圆 (E)">
                            <Ellipse Width="15" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" StrokeThickness="1.6" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolArrow" Tag="Arrow" Style="{StaticResource ToolButton}" Click="OnToolClick" ToolTip="箭头 (A)">
                            <Path Data="M2,14 L13,3 M6,3 H13 V10" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolLine" Tag="Line" Style="{StaticResource ToolButton}" Click="OnToolClick" ToolTip="直线 (L)">
                            <Path Data="M2,14 L14,2" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolPen" Tag="Pen" Style="{StaticResource ToolButton}" Click="OnToolClick" ToolTip="画笔 (P)" Content="&#xE70F;" />
                        <ToggleButton x:Name="ToolHighlighter" Tag="Highlighter" Style="{StaticResource ToolButton}" Click="OnToolClick" ToolTip="荧光笔 (H)" Content="&#xE7E6;" />
                        <ToggleButton x:Name="ToolText" Tag="Text" Style="{StaticResource ToolButton}" Click="OnToolClick" ToolTip="文字 (T)">
                            <TextBlock Text="T" FontFamily="Segoe UI" FontWeight="Bold" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolMosaic" Tag="Mosaic" Style="{StaticResource ToolButton}" Click="OnToolClick" ToolTip="马赛克 (M)">
                            <Path Data="M1,1 h4 v4 h-4 z M9,1 h4 v4 h-4 z M5,5 h4 v4 h-4 z M13,5 h2 v4 h-2 z M1,9 h4 v4 h-4 z M9,9 h4 v4 h-4 z M5,13 h4 v2 h-4 z M13,13 h2 v2 h-2 z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolBlur" Tag="Blur" Style="{StaticResource ToolButton}" Click="OnToolClick" ToolTip="高斯模糊 (B)">
                            <Path Data="M8,1.5 C8,1.5 3,7.2 3,10.5 A5,5 0 0 0 13,10.5 C13,7.2 8,1.5 8,1.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" StrokeThickness="1.6" Fill="#44FFFFFF" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolNumber" Tag="Number" Style="{StaticResource ToolButton}" Click="OnToolClick" ToolTip="序号 (N)">
                            <Grid Width="17" Height="17">
                                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" StrokeThickness="1.5" />
                                <TextBlock Text="1" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>

                        <Rectangle Style="{StaticResource ToolSeparator}" />
                        <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Click="OnUndo" ToolTip="撤销 (Ctrl+Z)" Content="&#xE7A7;" />
                        <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Click="OnRedo" ToolTip="重做 (Ctrl+Y)" Content="&#xE7A6;" />

                        <Rectangle Style="{StaticResource ToolSeparator}" />
                        <Button Style="{StaticResource ToolButton}" Click="OnLongCapture" ToolTip="长截图（滚动截取）">
                            <Path Data="M8,1 V15 M4,5 L8,1 L12,5 M4,11 L8,15 L12,11" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="OnOcr" ToolTip="离线文字识别 / 扫码 (Ctrl+O)">
                            <TextBlock Text="文" FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="OnTranslate" ToolTip="AI 翻译，译文显示在原位置 (Ctrl+T)">
                            <TextBlock Text="译" FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="OnPin" ToolTip="贴到屏幕 (Ctrl+P)" Content="&#xE718;" />
                        <Button x:Name="HdrButton" Style="{StaticResource ToolButton}" Click="OnSaveHdr" Visibility="Collapsed"
                                ToolTip="保存 HDR 原图 (.jxr，不含标注)">
                            <TextBlock Text="HDR" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="OnSave" ToolTip="保存 (Ctrl+S)" Content="&#xE74E;" />

                        <Rectangle Style="{StaticResource ToolSeparator}" />
                        <Button Style="{StaticResource ToolButton}" Click="OnCancel" ToolTip="退出 (Esc)" Content="&#xE711;" />
                        <Button Style="{StaticResource ToolButton}" Click="OnCopy" ToolTip="复制到剪贴板并完成 (Enter / 双击)"
                                Content="&#xE8FB;" Foreground="#FF5FD38D" />
                    </StackPanel>
                </Border>

                <!-- Property bar for the active annotation tool or selected annotation -->
                <Border x:Name="PropertyBar" Style="{StaticResource ToolbarBorder}" Margin="0,6,0,0"
                        HorizontalAlignment="Left" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="SizePanel" Orientation="Horizontal" VerticalAlignment="Center" />
                        <Rectangle x:Name="ColorSeparator" Style="{StaticResource ToolSeparator}" />
                        <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                        <Rectangle x:Name="DeleteSeparator" Style="{StaticResource ToolSeparator}" Visibility="Collapsed" />
                        <Button x:Name="DeleteSelectedButton" Style="{StaticResource ToolButton}" Width="28" Height="26"
                                Click="OnDeleteSelectedAnnotation" Visibility="Collapsed" ToolTip="删除选中标注 (Delete)"
                                Content="&#xE74D;" Foreground="#FFFF6B6B" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBox x:Name="TextEditor" Visibility="Collapsed" MinWidth="40" AcceptsReturn="True"
                     InputMethod.IsInputMethodEnabled="True"
                     Background="Transparent" BorderBrush="#AA2F7CF6" BorderThickness="1" Padding="0"
                     CaretBrush="White" Cursor="IBeam" TextWrapping="NoWrap" />
        </Canvas>
    </Grid>
</Window>
