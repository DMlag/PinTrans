<Window x:Class="AiPhoto.App.Viewer.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tr="clr-namespace:AiPhoto.App.Translation"
        Title="AiPhoto" Width="900" Height="760" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}"
        Background="#FF2B2B2B" UseLayoutRounding="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF202124" Padding="6,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Click="OnCopy" ToolTip="复制图片 (Ctrl+C)" Content="&#xE8C8;" />
                    <Button Style="{StaticResource ToolButton}" Click="OnSave" ToolTip="另存为 (Ctrl+S)" Content="&#xE74E;" />
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button x:Name="TranslateButton" Style="{StaticResource ToolButton}" Width="64" Click="OnTranslate" ToolTip="AI 翻译整张图片 (Ctrl+T)">
                        <TextBlock Text="AI 翻译" FontFamily="{StaticResource UiFont}" FontSize="13" />
                    </Button>
                    <ToggleButton x:Name="OriginalToggle" Style="{StaticResource ToolButton}" Width="48" Click="OnToggleOriginal" ToolTip="显示原文">
                        <TextBlock Text="原文" FontFamily="{StaticResource UiFont}" FontSize="13" />
                    </ToggleButton>
                    <Button Style="{StaticResource ToolButton}" Width="64" Click="OnCopyText" ToolTip="复制全部译文">
                        <TextBlock Text="复制译文" FontFamily="{StaticResource UiFont}" FontSize="13" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Width="64" Click="OnFitWidth" ToolTip="适应窗口宽度">
                        <TextBlock Text="适应宽度" FontFamily="{StaticResource UiFont}" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Width="48" Click="OnActualSize" ToolTip="原始大小 (Ctrl+0)">
                        <TextBlock Text="100%" FontFamily="Segoe UI" FontSize="12" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#FFCFCFCF" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="12,0,6,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="OnPreviewMouseWheel">
            <Grid x:Name="ContentHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ContentScale" />
                </Grid.LayoutTransform>
                <Image x:Name="ImageView" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                <tr:TranslationLayer x:Name="Layer" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
